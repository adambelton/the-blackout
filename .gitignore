.DS_Store
node_modules/
dist/
.next/
.turbo/

# Next.js generated TypeScript shim — regenerated by `next dev` / `next build`,
# kept in each app's tsconfig `include`. Next.js recommends gitignoring it
# (https://nextjs.org/docs/app/api-reference/config/typescript). The bare
# pattern matches both apps/blackout/client + apps/kairos/client at any depth.
next-env.d.ts

.env*
!.env.example

# Contributor personal development folders (see docs/CONTRIBUTING.md)
docs/*/
*.tsbuildinfo

# Broadcast recordings (match data, transcription logs)
data/
.vercel

# Claude Code local runtime state (permission grants, scheduled-task
# locks, session scratch — all machine-local, not for sharing). Skills
# are the exception: per-app CLAUDE.md files reference `.claude/skills/`
# as the canonical home for repeated working rules, so the skill files
# themselves are version-controlled. Add further exceptions here only
# when something else under `.claude/` becomes shared rather than
# machine-local (e.g. a tracked `settings.json` distinct from the
# `settings.local.json` runtime override).
.claude/*
!.claude/skills/

# Scratch scripts — transient API probes + smoke tests used during
# investigation. Commit a probe only when it's worth keeping as a
# reference (see apps/blackout/server/src/scripts/probe-livescores-latest.mts).
apps/blackout/server/src/scripts/probe-*
apps/blackout/server/src/scripts/smoke-*
apps/blackout/server/src/scripts/analyse-*
!apps/blackout/server/src/scripts/probe-livescores-latest.mts

# Scratch output / local-only artefacts
tmp/

