# Anthropic (narrative generation)
ANTHROPIC_API_KEY=

# Database (Postgres)
DATABASE_URL=postgresql://localhost:5432/kairos

# Consumer auth — comma-separated allowlist of bearer tokens that
# consumer services (e.g. apps/blackout/server) present on every
# /broadcasts/* call. Each consumer sends its own KAIROS_API_KEY
# which must appear in this list. Generate with `openssl rand -hex 32`.
KAIROS_API_KEYS=

# Admin auth (K6.3a) — Better Auth session-cookie validation for the
# /profiles/* + /specs/* surface. The admin app (apps/kairos/client)
# issues cookies via email/password sign-in (sign-up disabled; users
# seeded by `apps/kairos/client/scripts/create-user.ts`); this server
# only validates them. All four vars must match the admin app's values
# (the secret in particular — drift = silent 401s).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_COOKIE_DOMAIN=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:5050

# Internal-script bypass for tests + ops scripts. When set, requests
# carrying matching `X-Internal-Api-Secret` header satisfy admin-route
# session checks without going through OAuth. Fail-closed: missing or
# empty = bypass disabled. Generate with `openssl rand -hex 32`.
INTERNAL_API_SECRET=

# Server port for local development.
PORT=5050

# PostHog telemetry (invariant events + generation metrics). Same
# project as the web app. When unset, telemetry stays stderr-only.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
