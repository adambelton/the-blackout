# Better Auth — MUST match `apps/kairos/server`'s values (drift = silent 401s).
# Generate the secret with `openssl rand -hex 32`. Same value as the
# server's `BETTER_AUTH_SECRET` value.
BETTER_AUTH_SECRET=
# Public URL of this app (the issuer side). Local dev defaults to
# localhost:3001.
BETTER_AUTH_URL=http://localhost:3001
# Leading-dot domain to scope the session cookie across the kairos.*
# subdomains. Leave empty in dev — Better Auth defaults to host-only,
# which works fine on localhost.
BETTER_AUTH_COOKIE_DOMAIN=
# Comma-separated origins Better Auth accepts requests from. Dev:
# http://localhost:3001 (this app) + http://localhost:5050 (kairos-server).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:5050

# Postgres — Kairos's database. Same DB the server uses; auth tables
# live there (migrated by apps/kairos/server's drizzle setup).
KAIROS_DB_URL=postgresql://localhost:5432/kairos
