# Anthropic (Claude — prompt suggestions in the studio, tag derivation).
# Without this, /studio/prompts/suggest throws "ANTHROPIC_API_KEY is
# not set — prompt suggestion unavailable".
ANTHROPIC_API_KEY=

# Sportmonks (match events, fixtures)
SPORTMONKS_API_TOKEN=

# Deepgram (radio stream transcription)
DEEPGRAM_API_KEY=

# OpenAI (TTS — current primary)
OPENAI_API_KEY=

# ElevenLabs (TTS — beta default)
ELEVENLABS_API_KEY=
# Optional — defaults applied in code if unset:
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Deepgram Aura 2 (TTS) — reuses DEEPGRAM_API_KEY above.

# Hume Octave 2 (TTS — expressive, emotion-aware alternative)
HUME_API_KEY=
# Optional — used as the fallback voice when the request omits voiceId
# HUME_VOICE_ID=

# TTS defaults stamped on new broadcast rows at createBroadcast.
# Both must be set together; when either is missing, new broadcasts
# get NULL tts columns and the moderator must pick a voice before
# the conductor can synthesise. The committed reference values are
# Hume + the "Booming British Narrator" voice id below.
DEFAULT_TTS_PROVIDER=hume
DEFAULT_TTS_VOICE_ID=84aaf67b-dcab-409d-9f48-8c4aa7abbb24

# Cloudflare R2 (broadcast audio + illustration storage).
# Optional for local development. Leave R2_* unset to use
# InMemoryStorage instead.
#
# R2_PUBLIC_URL — when set, getPublicUrl returns permanent
# `${R2_PUBLIC_URL}/${key}` URLs (R2 public access via r2.dev or
# custom domain, served from Cloudflare's edge). When unset, falls
# back to presigned URLs with 7-day TTL.
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Replicate (illustration generation — per-passage images on live broadcasts)
REPLICATE_API_TOKEN=
# Optional — model override. Defaults to `black-forest-labs/flux-schnell`
# (cheap + fast, good enough for the current pencil-sketch target).
# REPLICATE_MODEL=black-forest-labs/flux-dev
# Illustration style prefix lives in content/illustration-style.md at
# the repo root — edit there, not here.

# Kairos (narrative orchestration service)
KAIROS_URL=http://localhost:5050
# Bearer token sent on every Kairos request. Must match one of the
# values in Kairos's KAIROS_API_KEYS env (comma-separated allowlist).
KAIROS_API_KEY=

# Database (Postgres)
DATABASE_URL=postgresql://localhost:5432/blackout

# Better Auth — session validation only. The server reads sessions
# issued by the web side (apps/blackout/client), so these MUST match
# the values in apps/blackout/client's env, otherwise cookies signed
# by web won't validate here and every WS upgrade / role-gated route
# returns 401.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional cookie domain for a self-hosted environment.
# BETTER_AUTH_COOKIE_DOMAIN=.example.com
# Comma-separated list. Local dev: http://localhost:3000,http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000

# CORS allowlist for Hono HTTP routes (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# Internal API secret — when set, lets trusted internal callers
# (e.g. replay scripts) bypass role checks via an X-Internal-Secret
# header. Leave unset to disable the bypass.
INTERNAL_API_SECRET=

# PostHog telemetry (invariant events + broadcast lifecycle beats).
# Same project as the web app's NEXT_PUBLIC_POSTHOG_KEY — reading as
# plain POSTHOG_KEY server-side to avoid the NEXT_PUBLIC_ exposure
# convention. When unset, telemetry stays stderr-only.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Server port for local development.
PORT=4000
