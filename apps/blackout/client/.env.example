# API base (Blackout backend server)
# Falls back to http://localhost:4000 in code if unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL (moderator + matchroom subscriptions)
# Falls back to ws://localhost:4000 in code if unset.
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# PostHog analytics (EU host)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Better Auth -----------------------------------------------------
# Random 32-byte string — `openssl rand -base64 32`. Signs sessions.
BETTER_AUTH_SECRET=
# Canonical URL the app is served from. Updates per environment.
BETTER_AUTH_URL=http://localhost:3000
# Prod-only. Leading-dot domain so the session cookie scopes to
# every subdomain of a configured parent domain. Leave
# unset for local dev — Better Auth defaults to host-only cookies
# which work fine on localhost.
# BETTER_AUTH_COOKIE_DOMAIN=.example.com
# Comma-separated. apps/blackout/server validates sessions issued here, so
# both must list the same set of trusted origins.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
# Email of the founder / initial admin. On first sign-in, a user with
# this email gets role="admin" stamped by the user.create hook.
ADMIN_EMAIL=

# Database (shared with the Blackout server — Better Auth tables live
# alongside app data in the same Postgres).
DATABASE_URL=postgresql://localhost:5432/blackout
